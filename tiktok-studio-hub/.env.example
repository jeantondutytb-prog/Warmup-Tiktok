# Créez une app sur https://developers.tiktok.com/ (Login Kit + Display API)
TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret
TIKTOK_REDIRECT_URI=http://localhost:8080/auth/callback

# URL publique de l'app (doit correspondre à la redirect URI enregistrée)
APP_BASE_URL=http://localhost:8080

# Mode démo sans clés TikTok (stats fictives pour tester l'UI)
DEMO_MODE=0
