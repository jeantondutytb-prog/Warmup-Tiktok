#!/usr/bin/env bash
# Un seul lancement : WDA + pont Vercel. Le Start se fait ensuite sur le dashboard.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
if [[ -f "$ROOT/venv/bin/activate" ]]; then
  # shellcheck disable=SC1091
  source "$ROOT/venv/bin/activate"
fi
exec python -m agent "$@"
