# Appium — lancer avec: appium --relaxed-security
APPIUM_SERVER_URL=http://127.0.0.1:4723

# iPhone connecté en USB (laisser vide pour auto-détection via idevice_id)
IOS_UDID=

# Nom du device affiché dans Appium
IOS_DEVICE_NAME=iPhone

# Version iOS (ex: 17.5) — requis pour les caps Appium
IOS_PLATFORM_VERSION=17.0

# Chemin vers WebDriverAgent (après build Xcode)
WDA_LOCAL_PORT=8100

# Profil de warmup par défaut: observer | light | moderate | active
WARMUP_PROFILE=observer

# Durée max session en minutes (0 = utiliser le profil)
SESSION_DURATION_MINUTES=0
