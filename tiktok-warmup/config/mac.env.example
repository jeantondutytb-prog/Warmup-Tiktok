# Copie ce fichier en .env à la racine de tiktok-warmup/
# cp config/mac.env.example .env

# iPhone XS de Jean — modifie si ton UDID change
IPHONE_UDID=00008020-000D0CE43A99002E

# Apple Developer Team
DEVELOPMENT_TEAM=U284BGAVKL
WDA_BUNDLE_ID=com.jean.wda.runner
IOS_DEPLOYMENT_TARGET=18.7

# Chemins Mac (Jean) — adapte si ton user n'est pas "jean"
WDA_PROJECT=/Users/jean/.appium/node_modules/appium-xcuitest-driver/node_modules/appium-webdriveragent/WebDriverAgent.xcodeproj
WDA_DERIVED_DATA=/Users/jean/Library/Developer/Xcode/DerivedData/WebDriverAgent-entqkdybqjzegiahlgkxvxghpzdf

# URL WebDriverAgent — laisse vide pour auto-détection au lancement
# Cherche "ServerURLHere->" dans le log xcodebuild si besoin
WDA_URL=

# Port du dashboard warmup
WARMUP_PORT=8000
